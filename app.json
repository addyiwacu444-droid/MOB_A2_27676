{
  "expo": {
    "name": "Adelphine Portfolio",
    "slug": "CMPortfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "rw.ac.ines.ug2527676.cmportfolio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to select your portfolio profile picture."
        }
      ]
    ]
  }
}
